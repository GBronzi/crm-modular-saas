NODE_ENV=development
POSTGRES_DB=crm
POSTGRES_ADMIN_USER=crm_admin
POSTGRES_ADMIN_PASSWORD=admin-local-change-me
POSTGRES_APP_USER=crm_app
POSTGRES_APP_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgresql://crm_app:local-dev-only-change-me@localhost:5432/crm
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_ORIGIN=http://localhost:5173
API_PORT=3000

